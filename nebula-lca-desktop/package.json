{
  "name": "nebula-lca-desktop",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.27.0",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:web": "node scripts/build-web.js",
    "build:api": "node scripts/build-api.js",
    "desktop:build": "pnpm run build:web && pnpm run build:api && pnpm run build",
    "desktop:dist": "pnpm run desktop:build && electron-builder --config electron-builder.yml",
    "desktop:audit": "node scripts/audit-release.js",
    "desktop:smoke": "pnpm run build && electron dist/main.js --smoke"
  },
  "dependencies": {
    "electron-is-dev": "^3.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "typescript": "^5.8.3"
  }
}
