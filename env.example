# Compose project name
COMPOSE_PROJECT_NAME=nebula-lca

# Public frontend port on host
WEB_PORT=16988

# API runtime
DEBUG=false
ADMIN_TOKEN=change_me_to_a_strong_token

# Startup maintenance / bootstrap
AUTO_BOOTSTRAP_REFERENCE_DATA_ON_STARTUP=true
KEEP_LATEST_VERSIONS_PER_PROJECT=1000
AUTO_PRUNE_ON_STARTUP=true
AUTO_VACUUM_AFTER_PRUNE_ON_STARTUP=false
IMPORT_CACHE_RETENTION_HOURS=24
IMPORT_CACHE_CLEANUP_ON_TERMINAL=true

# Runtime storage is mounted by docker-compose.yml:
# - nebula-lca-api-data: SQLite DB
# - nebula-lca-api-import-cache: resumable LCI/LCIA uploads and extracted files.
#   Completed/cancelled jobs are cleaned automatically; failed/paused uploads are
#   kept for IMPORT_CACHE_RETENTION_HOURS so users can resume or inspect them.
# - nebula-lca-api-runtime: generated LCIA runtime artifacts shared by API and solver

# TIDAS reference files (optional overrides)
# NEBULA_TIDAS_REFERENCE_SEED=
# NEBULA_TIDAS_REFERENCE_CATALOG=
